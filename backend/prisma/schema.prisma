generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelAdmin {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum StatusContaAdmin {
  PENDENTE
  APROVADO
  REJEITADO
}

model UsuarioAdmin {
  id              String           @id @default(uuid())
  nome            String           @db.VarChar(120)
  email           String           @unique @db.VarChar(160)
  senhaHash       String           @map("senha_hash") @db.VarChar(255)
  papel           PapelAdmin       @default(ADMIN)
  status          StatusContaAdmin @default(PENDENTE)
  ativo           Boolean          @default(false)
  avaliadoEm      DateTime?        @map("avaliado_em")
  avaliadoPorId   String?          @map("avaliado_por_id")
  criadoEm        DateTime         @default(now()) @map("criado_em")
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em")
  avaliadoPor     UsuarioAdmin?    @relation("AvaliacaoContasAdmin", fields: [avaliadoPorId], references: [id], onDelete: SetNull)
  contasAvaliadas UsuarioAdmin[]   @relation("AvaliacaoContasAdmin")

  @@index([status])
  @@index([avaliadoPorId])
  @@map("user_admin")
}

model Setor {
  id          String      @id @default(uuid())
  nome        String      @unique @db.VarChar(100)
  descricao   String?     @db.Text
  ativo       Boolean     @default(true)
  indicadores Indicador[]

  @@map("setor")
}

model Indicador {
  id        String              @id @default(uuid())
  nome      String              @db.VarChar(140)
  unidade   String              @db.VarChar(40)
  descricao String?             @db.Text
  setorId   String              @map("setor_id")
  ativo     Boolean             @default(true)
  criadoEm  DateTime            @default(now()) @map("criado_em")
  setor     Setor               @relation(fields: [setorId], references: [id], onDelete: Restrict)
  registros RegistroIndicador[]

  @@index([setorId])
  @@map("indicador")
}

model FonteDado {
  id         String              @id @default(uuid())
  nome       String              @db.VarChar(150)
  descricao  String?             @db.Text
  tipo       String              @db.VarChar(50)
  referencia String?             @db.Text
  registros  RegistroIndicador[]

  @@map("fonte_dado")
}

model RegistroIndicador {
  id           String    @id @default(uuid())
  indicadorId  String    @map("indicador_id")
  fonteId      String    @map("fonte_id")
  periodo      DateTime  @db.Date
  valor        Decimal   @db.Decimal(14, 2)
  publicado    Boolean   @default(false)
  observacao   String?   @db.Text
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  indicador    Indicador @relation(fields: [indicadorId], references: [id], onDelete: Restrict)
  fonte        FonteDado @relation(fields: [fonteId], references: [id], onDelete: Restrict)

  @@unique([indicadorId, fonteId, periodo])
  @@index([fonteId])
  @@index([periodo])
  @@map("registro_indicador")
}
